# Project
PROJECT_NAME="FanSpace Backend API"
ENVIRONMENT="development"
DEBUG=true
PORT=8000

# Security
SECRET_KEY="fanspace-super-secret-scientific-benchmark-key-change-in-prod"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database (PostgreSQL)
DATABASE_URL="postgresql+asyncpg://fanspace:fanspace_password@localhost:5433/fanspace_db"
DATABASE_POOL_SIZE=15
DATABASE_MAX_OVERFLOW=5

# Redis
REDIS_URL="redis://localhost:6379/0"

# External Services
PAYOS_CLIENT_ID=""
PAYOS_API_KEY=""
PAYOS_CHECKSUM_KEY=""
LIVEKIT_URL=""
LIVEKIT_API_KEY=""
LIVEKIT_API_SECRET=""
