# Project
PROJECT_NAME="FanSpace Backend API"
ENVIRONMENT="development"
DEBUG=true
PORT=8000

# Security
SECRET_KEY="change-me-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database (PostgreSQL)
DATABASE_URL="postgresql+asyncpg://fanspace:fanspace_password@localhost:5433/fanspace_db"
DATABASE_POOL_SIZE=15
DATABASE_MAX_OVERFLOW=5

# Redis
REDIS_URL="redis://localhost:6379/0"

# External Services
PAYOS_CLIENT_ID=""
PAYOS_API_KEY=""
PAYOS_CHECKSUM_KEY=""
LIVEKIT_URL=""
LIVEKIT_API_KEY=""
LIVEKIT_API_SECRET=""

# Google OAuth2
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:8000/api/v1/auth/google/callback"

# Gmail SMTP Email Delivery
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
EMAILS_FROM_EMAIL=""
EMAILS_FROM_NAME="FanSpace Security"
DEBUG_OTP_IN_RESPONSE=true

# Cloudinary Media Storage
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
